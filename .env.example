# Synkro — Modèle de Variables d'Environnement
# ==============================================================================
# ATTENTION DE SÉCURITÉ :
# Ne commitez JAMAIS de fichier .env contenant des valeurs réelles dans Git.
# Ce fichier .env.example sert uniquement de modèle de configuration.
# Pour le développement local, copiez ce fichier vers .env :
#   cp .env.example .env
# Pour la production, configurez ces variables dans le tableau de bord Vercel.
# ==============================================================================

# ==================== 1. BASE DE DONNÉES POSTGRESQL ====================
# En développement (Docker local) :
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synkro?schema=public"
# En développement local sans pooler, DIRECT_URL pointe vers la même instance que DATABASE_URL :
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/synkro?schema=public"

# En production hébergée (ex: Neon Serverless Postgres, Supabase, Vercel Postgres, AWS RDS) :
# - DATABASE_URL utilise le connection pooler (mode transaction / pgbouncer / port pooler) pour le client Next.js :
#   DATABASE_URL="postgresql://synkro_user:secret@ep-xyz-pooler.eu-central-1.aws.neon.tech/synkro?sslmode=require"
# - DIRECT_URL doit obligatoirement contenir la véritable URL de connexion directe sans pooler (port 5432 standard)
#   fournie par l'hébergeur PostgreSQL, indispensable à Prisma pour exécuter les migrations DDL (prisma migrate deploy) :
#   DIRECT_URL="postgresql://synkro_user:secret@ep-xyz.eu-central-1.aws.neon.tech/synkro?sslmode=require"

# Paramètres optionnels pour Docker Compose local :
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="synkro"

# ==================== 2. COMPTE ADMINISTRATEUR INITIAL ====================
# Adresse e-mail du compte administrateur principal :
ADMIN_EMAIL="fazethiam@gmail.com"

# Mot de passe administrateur initial :
# ⚠️ RÈGLE DE SÉCURITÉ CRITIQUE :
# - En production, cette variable est OBLIGATOIRE lors de la première initialisation.
# - Doit comporter au minimum 12 caractères complexes.
# - N'utilisez JAMAIS un mot de passe par défaut, de démonstration ou trivial ("passer123", "admin", etc.).
# - Une fois le compte créé, le mot de passe ne sera plus écrasé par les ré-exécutions du seed.
ADMIN_INITIAL_PASSWORD=""

# Sécurité anti-élévation de privilèges :
# Mettre à "true" pour confirmer explicitement la promotion d'un compte utilisateur déjà existant au rôle ADMIN.
# Par défaut à "false", empêchant tout administrateur mal configuré de convertir accidentellement un étudiant en administrateur.
ALLOW_ADMIN_ROLE_PROMOTION="false"

# Réinitialisation explicite du mot de passe administrateur via `npm run admin:setup` :
# Mettre à "true" conjointement avec ADMIN_INITIAL_PASSWORD pour forcer l'écrasement du mot de passe d'un administrateur existant.
RESET_ADMIN_PASSWORD="false"

# ==================== 3. DONNÉES DE DÉMONSTRATION (LOCAL UNIQUEMENT) ====================
# Autorisation explicite pour générer les comptes de démonstration et les 68 étudiants de test :
# - "true" : génère les données de test (autorisé EXCLUSIVEMENT si la base est strictement locale : localhost, 127.0.0.1, ::1).
# - "false" ou absent : ignore la génération des données de test.
# ⚠️ RÈGLE DE SÉCURITÉ ABSOLUE : cette variable est STRICTEMENT ignorée dès que l'hôte de la base est distant,
# inconnu, ou dès que NODE_ENV est en production.
SEED_DEMO_DATA="true"

# ==================== 4. AUTHENTIFICATION NEXTAUTH v5 ====================
# Clé secrète cryptographique de 32+ caractères pour signer les sessions JWT.
# À générer avec : openssl rand -base64 32 (ou node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=""

# URL publique de l'application (http://localhost:3000 en dev, https://synkro.vercel.app en prod)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth 2.0 (Optionnel en dev, requis pour la connexion Google des étudiants) :
# URI de redirection à autoriser dans Google Cloud Console :
#   En dev  : http://localhost:3000/api/auth/callback/google
#   En prod : https://synkro.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ==================== 5. E-MAILS TRANSACTIONNELS ====================
# Fournisseur : "CONSOLE" (développement local) ou "RESEND" (production avec API réelle)
EMAIL_PROVIDER="CONSOLE"
EMAIL_FROM="Synkro <no-reply@synkro.app>"

# Clé API Resend (requise uniquement si EMAIL_PROVIDER="RESEND")
RESEND_API_KEY=""

# ==================== 6. STOCKAGE PHOTOS & CRON VERCEL ====================
# Jeton Vercel Blob (généré automatiquement lors de la création d'un Blob Store sur Vercel) :
# En l'absence de ce jeton en dev, l'application utilise public/uploads/
BLOB_READ_WRITE_TOKEN=""

# Clé secrète pour authentifier l'appel planifié Vercel Cron vers /api/cron/weekly-reminder
CRON_SECRET=""

# ==================== 7. ORIGINES AUTORISÉES (CSRF & SERVER ACTIONS) ====================
# Origines autorisées pour les Server Actions en production (domaines séparés par des virgules, ex: synkro.vercel.app,mondomaine.com).
# Si non renseigné, Synkro déduit automatiquement le domaine de confiance depuis NEXT_PUBLIC_APP_URL et NEXTAUTH_URL.
SERVER_ACTIONS_ALLOWED_ORIGINS=""

# Origines additionnelles autorisées EXCLUSIVEMENT en développement (ex: tunnels temporaires).
# ⚠️ En production (NODE_ENV="production"), cette variable et les domaines *.devtunnels.ms sont STRICTEMENT ignorés.
ALLOWED_DEV_ORIGINS=""

# ==================== 8. CONFIGURATION GLOBALE ====================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Synkro"
